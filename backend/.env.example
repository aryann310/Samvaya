# Samvaya Backend Environment

# Server
PORT=5000
NODE_ENV=development

# Database mode: "demo" (JSON DataStore) | "mongodb" (local or Atlas)
# Default is demo so the app works without MongoDB.
DATABASE_MODE=demo

# MongoDB — required when DATABASE_MODE=mongodb
# Local Windows MongoDB service (no Docker):
MONGODB_URI=mongodb://127.0.0.1:27017
# Or Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=samvaya
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# SLM / Gemini (optional — advisor falls back to deterministic engines)
# SLM_API_KEY=
# GEMINI_API_KEY=

# DigiLocker / Setu
# sandbox|mock = local consent simulator (works offline)
# production|live = real Setu DigiLocker API (needs all three credentials)
DIGILOCKER_ENV=sandbox
DIGILOCKER_API_BASE_URL=https://dg-sandbox.setu.co
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_PRODUCT_INSTANCE_ID=
DIGILOCKER_AGGREGATOR_API_KEY=
DIGILOCKER_REDIRECT_URL=http://localhost:5000/api/v2/digilocker/callback
DIGILOCKER_FRONTEND_SUCCESS_URL=http://localhost:5173/business?kyc=success
DIGILOCKER_FRONTEND_FAILURE_URL=http://localhost:5173/business?kyc=failed
DIGILOCKER_MOBILE_REDIRECT_SCHEME=myapp://digilocker-callback
# 64-char hex (32 bytes) for AES-256-GCM PII encryption
DIGILOCKER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
